rules_version = '2';

// Recommandations de règles Firebase Storage pour Hylia Plaza.
// À déployer avec :  firebase deploy --only storage
//
// Les états de sauvegarde sont stockés sous : saves/{uid}/{core}/{game}.state
// Chaque utilisateur ne peut lire/écrire que dans son propre dossier.

service firebase.storage {
  match /b/{bucket}/o {
    match /saves/{uid}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
